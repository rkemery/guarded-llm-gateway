# Copy to .env and fill in only what you use. Nothing here is required offline.

# Backend: "fake" (offline default, no network) or "azure" (Foundry via llm-eval-harness)
GATEWAY_BACKEND=fake
GATEWAY_PRIMARY_MODEL=gpt-6-luna
GATEWAY_FALLBACK_MODEL=gpt-5-mini
# Hard dollar cap per gateway process for live calls (harness DollarCap)
GATEWAY_DOLLAR_CAP_USD=1.00
# Optional disk cache for live replies (harness CachedClient)
GATEWAY_CACHE_DIR=

# Azure Foundry (read by llm-eval-harness FoundryClient). Without a key, Entra ID is used.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

# Optional: Azure AI Content Safety Prompt Shields. Off when either is empty.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Guard and reliability settings
# Unset: the detector profile chosen on the dev split (results/detectors/thresholds.json).
# Set to piguard, deberta or piguard,deberta to override, or to empty for none.
# GATEWAY_DETECTORS=piguard
GATEWAY_MAX_INPUT_CHARS=4000
GATEWAY_DEADLINE_S=20
GATEWAY_MODEL_TIMEOUT_S=12
GATEWAY_RATE_LIMIT=30/minute
GATEWAY_TOKEN_BUDGET_PER_MINUTE=20000
# Comma-separated allowed X-API-Key values. Empty accepts any caller and keys rate
# limits on the client IP. Use that for development only.
GATEWAY_API_KEYS=
# Random per process when empty
GATEWAY_CANARY=
GATEWAY_TORCH_THREADS=2
# Adds the per-layer trace to responses. Leave off in anything public.
GATEWAY_DEBUG=0
